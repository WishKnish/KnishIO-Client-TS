{
  "name": "@wishknish/knishio-client-ts",
  "version": "0.9.7",
  "productName": "Knish.IO TypeScript SDK Client",
  "description": "TypeScript implementation of the Knish.IO SDK to consume Knish.IO GraphQL APIs with enhanced type safety.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/WishKnish/KnishIO-Client-TS.git"
  },
  "contributors": [
    {
      "name": "Eugene Teplitsky",
      "email": "eugene@wishknish.com",
      "homepage": "https://wishknish.com",
      "role": "developer"
    }
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "wishknish",
    "knishio",
    "blockchain",
    "dag",
    "post-blockchain",
    "dlt",
    "client",
    "graphql",
    "xmss",
    "post-quantum",
    "quantum-safe",
    "sdk",
    "typescript",
    "ml-kem768",
    "cryptography",
    "crystals-kyber",
    "fips-202",
    "fips-203"
  ],
  "dependencies": {
    "@noble/post-quantum": "^0.7.0",
    "@urql/core": "^6.0.3",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.2.1",
    "jssha": "^3.3.2",
    "tslib": "^2.8.1",
    "wonka": "^6.3.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/jssha": "^3.0.0",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "wonka": "6.3.6"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8",
    "supports es6-module"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs,iife --clean",
    "build:test": "tsup src/index.ts --format esm,cjs,iife --tsconfig tsconfig.build.json --clean",
    "build:dev": "tsup src/index.ts --format esm,cjs --dts --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "prepublishOnly": "npm run build",
    "selftest": "npm run build && node self-test.cjs"
  },
  "files": [
    "/src",
    "/dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "yarn@4.15.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
